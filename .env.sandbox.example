# Songa AI 2.0 — Vercel SANDBOX browser configuration
# Copy to .env.sandbox and replace values before running BUILD-RELEASES.ps1.
# These values are public in the browser bundle. Never put provider secrets here.
VITE_SUPABASE_URL=https://YOUR_SANDBOX_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SANDBOX_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Optional overrides; normally the app derives the functions URL from VITE_SUPABASE_URL.
# VITE_FLIGHT_SEARCH_FUNCTION_URL=https://YOUR_SANDBOX_PROJECT_REF.supabase.co/functions/v1/flight-search
# VITE_WHATSAPP_LINK_FUNCTION_URL=https://YOUR_SANDBOX_PROJECT_REF.supabase.co/functions/v1/whatsapp-link
