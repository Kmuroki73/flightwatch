# Copy the required public Supabase values into Vercel Project Settings > Environment Variables.
# Do not put service-role keys, AeroAPI keys, or Twilio secrets in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional override; normally the app derives this from VITE_SUPABASE_URL.
# VITE_FLIGHT_SEARCH_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/flight-search
